# ═══════════════════════════════════════════════════════════
# PRATIMA PAL — PORTFOLIO ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────
# APPLICATION
# ──────────────────────────────────────────────────────────

# Environment: production | development
APP_ENV=production

# Show PHP errors in browser (false in production)
APP_DEBUG=false

# Your live website URL (no trailing slash)
APP_URL=https://pratimapal.com

# Timezone (list: https://www.php.net/manual/en/timezones.asia.php)
APP_TIMEZONE=Asia/Kolkata


# ──────────────────────────────────────────────────────────
# SMTP — GMAIL
# ──────────────────────────────────────────────────────────
# 1. Go to Google Account → Security → 2-Step Verification → App Passwords
# 2. Generate an App Password for "Mail" + "Windows Computer"
# 3. Use that 16-character password as SMTP_PASSWORD (spaces are ok)
# ──────────────────────────────────────────────────────────

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_AUTH=true
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-gmail@gmail.com
SMTP_FROM_NAME=Pratima Pal Portfolio
SMTP_REPLY_TO=
SMTP_DEBUG=0


# ──────────────────────────────────────────────────────────
# SMTP — HOSTINGER (alternative — comment out Gmail above and
# uncomment these lines if you are using Hostinger hosting)
# ──────────────────────────────────────────────────────────

# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=ssl
# SMTP_AUTH=true
# SMTP_USERNAME=noreply@pratimapal.com
# SMTP_PASSWORD=YourHostingerEmailPassword
# SMTP_FROM_EMAIL=noreply@pratimapal.com
# SMTP_FROM_NAME=Pratima Pal Portfolio
# SMTP_REPLY_TO=
# SMTP_DEBUG=0


# ──────────────────────────────────────────────────────────
# SMTP — OTHER PROVIDERS
# ──────────────────────────────────────────────────────────
# Outlook / Office 365:
#   SMTP_HOST=smtp.office365.com | PORT=587 | SECURE=tls
#
# Yahoo Mail:
#   SMTP_HOST=smtp.mail.yahoo.com | PORT=465 | SECURE=ssl
#   (requires "Less secure app access" or App Password)
#
# SendGrid:
#   SMTP_HOST=smtp.sendgrid.net | PORT=587 | SECURE=tls
#   SMTP_USERNAME=apikey | SMTP_PASSWORD=your-sendgrid-api-key
#
# Mailgun:
#   SMTP_HOST=smtp.mailgun.org | PORT=587 | SECURE=tls
#   SMTP_USERNAME=postmaster@mg.yourdomain.com
# ──────────────────────────────────────────────────────────


# ──────────────────────────────────────────────────────────
# EMAIL ROUTING
# ──────────────────────────────────────────────────────────

# Where contact form submissions are delivered (your inbox)
RECIPIENT_EMAIL=pratimapal102002@gmail.com
RECIPIENT_NAME=Pratima Pal

# Optional comma-separated CC / BCC addresses (leave blank to skip)
CC_EMAIL=
BCC_EMAIL=


# ──────────────────────────────────────────────────────────
# SECURITY
# ──────────────────────────────────────────────────────────

# CSRF HMAC secret key — change this to a long random string
# Generate one: php -r "echo bin2hex(random_bytes(32));"
CSRF_SECRET=replace-with-a-long-random-secret-string

# CSRF token lifetime in seconds (default: 7200 = 2 hours)
CSRF_TOKEN_TTL=7200

# Allowed CORS origin — set to your exact domain for security
# e.g. https://pratimapal.com  (use * only for testing)
ALLOWED_ORIGIN=https://pratimapal.com


# ──────────────────────────────────────────────────────────
# RATE LIMITING
# ──────────────────────────────────────────────────────────

# Maximum form submissions per window per IP
RATE_LIMIT_MAX=5

# Rate limit window in seconds (default: 3600 = 1 hour)
RATE_LIMIT_WINDOW=3600

# Writable directory to store rate-limit files
# Should be OUTSIDE the webroot for security
# Default: system temp dir — override with an absolute path
# e.g. /home/yourusername/private/ratelimit
RATE_LIMIT_DIR=


# ──────────────────────────────────────────────────────────
# NOTES
# ──────────────────────────────────────────────────────────
# After creating .env:
#
#   1. Add .env to your .gitignore file immediately:
#      echo ".env" >> .gitignore
#
#   2. Set file permissions on the server:
#      chmod 600 .env
#
#   3. Install PHPMailer via Composer:
#      composer require phpmailer/phpmailer
#
#   4. Make sure the logs/ directory is writable:
#      mkdir logs && chmod 755 logs
#
#   5. Test with APP_DEBUG=true first, then switch to false
#      in production.
# ──────────────────────────────────────────────────────────
